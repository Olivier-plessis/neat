import 'dart:io';
import 'package:flutter/services.dart' show rootBundle;
import 'package:mason/mason.dart';

Future<void> generateProjectWithMason({
  required String appName,
  required String orgName,
  required String targetDirectory,
  required List<String> platforms,
}) async {

  // 1. Définir le chemin de sortie
  final projectPath = '$targetDirectory/$appName';

  // 2. Récupérer ta brique locale stockée dans les assets de l'app Desktop
  // Note : Mason gère très bien la lecture depuis un chemin local
  final brick = Brick.path('assets/bricks/clean_architecture_app');
  final generator = await MasonGenerator.fromBrick(brick);

  // 3. Mapper tes champs d'UI directement avec les variables attendues par ton brick.yaml
  final vars = <String, dynamic>{
    'name': appName,
    'org': orgName,
    'android': platforms.contains('android'),
    'ios': platforms.contains('ios'),
    'web': platforms.contains('web'),
    // ... toutes les variables que tu as définies dans ton repo github !
  };

  // 4. Lancer la génération
  final target = DirectoryTarget(Directory(projectPath));

  // Cette ligne va instantanément cloner et templater toute ton archi !
  await generator.generate(target, vars: vars);

  // 5. Optionnel : Lancer les commandes post-génération (comme flutter pub get)
  await Process.run('flutter', ['pub', 'get'], workingDirectory: projectPath);
}

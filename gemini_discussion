      // 3. Customisation de l'anatomie des Cards et Containers (Card Anatomy)
      cardTheme: CardTheme(
        elevation: 0,
        margin: EdgeInsets.zero,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(_containerRadius),
        ),

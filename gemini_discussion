class CreateAppCommand extends Command {
  @override
  final name = 'create';
  @override
  final description = 'Génère un nouveau projet Flutter avec Clean Architecture';

  CreateAppCommand() {
    argParser.addOption('name', abbr: 'n', help: 'Nom de l\'application', mandatory: true);

    // Ajout des flags pour les plateformes (désactivés par défaut)
    argParser.addFlag('android', help: 'Activer la plateforme Android', defaultsTo: false);
    argParser.addFlag('ios', help: 'Activer la plateforme iOS', defaultsTo: false);
    argParser.addFlag('web', help: 'Activer la plateforme Web', defaultsTo: false);
    argParser.addFlag('macos', help: 'Activer la plateforme macOS', defaultsTo: false);
    argParser.addFlag('windows', help: 'Activer la plateforme Windows', defaultsTo: false);
    argParser.addFlag('linux', help: 'Activer la plateforme Linux', defaultsTo: false);
  }

  @override
  void run() async {
    final logger = Logger();
    final appName = argResults?['name'] as String;
    final projectPath = './$appName';

    // 1. Détecter les plateformes choisies
    final platforms = <String>[];
    if (argResults?['android'] == true) platforms.add('android');
    if (argResults?['ios'] == true) platforms.add('ios');
    if (argResults?['web'] == true) platforms.add('web');
    if (argResults?['macos'] == true) platforms.add('macos');
    if (argResults?['windows'] == true) platforms.add('windows');
    if (argResults?['linux'] == true) platforms.add('linux');

    // Si l'utilisateur n'a coché aucun flag, on peut soit tout mettre par défaut, soit lever une erreur
    if (platforms.isEmpty) {
      // Option au choix : par défaut on met android et ios
      platforms.addAll(['android', 'ios']);
    }

    final progress = logger.progress('Création du projet Flutter $appName pour [${platforms.join(', ')}]...');

    // 2. Préparer les arguments pour flutter create
    // Cela va donner par exemple : ['create', 'super_app', '--platforms', 'android,ios']
    final flutterArgs = [
      'create',
      appName,
      '--platforms',
      platforms.join(',')
    ];

    // 3. Exécuter la commande Flutter standard avec les plateformes filtrées
    final result = await Process.run('flutter', flutterArgs);

    if (result.exitCode != 0) {
      progress.fail('Échec de flutter create : ${result.stderr}');
      return;
    }

    // ... (Le reste de ton code pour le pubspec.yaml et la Clean Archi reste identique)

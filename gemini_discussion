          borderSide: BorderSide(color: baseTheme.colorScheme.primary, width: 1.5),
        ),
      ),

      // 5. Configuration des dialogues (AppConfirmDialog, etc.)
      dialogTheme: DialogTheme(
        elevation: 0,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(_containerRadius),
        ),
      ),
    );
  }

  // Version sombre calquée sur le même seed de couleur
  static ThemeData get dark {
    final baseDarkTheme = ThemeData(
      useMaterial3: true,
      colorScheme: ColorScheme.fromSeed(
        seedColor: const Color(${extractedColorHex}),
        brightness: Brightness.dark,
      ),
    );

    return baseDarkTheme.copyWith(
      textTheme: GoogleFonts.${fontFamilyCamelCase}TextTheme(baseDarkTheme.textTheme).copyWith(
        bodyMedium: baseDarkTheme.textTheme.bodyMedium?.copyWith(fontSize: ${baseSizeValue}),
      ),
      elevatedButtonTheme: light.elevatedButtonTheme,
      outlinedButtonTheme: light.outlinedButtonTheme,
      cardTheme: light.cardTheme.copyWith(
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(_containerRadius),
        ),
      ),
      inputDecorationTheme: light.inputDecorationTheme,
      dialogTheme: light.dialogTheme,
    );
  }

#!/bin/sh
# Before a push: the Dart files it touches must be `dart format`-clean (the
# check the generated projects' CI runs on `.`).
#
# NEAT's own tree is not formatted as a whole yet, so this checks what the push
# touches, not `.`. Once the repo has been formatted in one commit, replace the
# body with:  dart format --output=none --set-exit-if-changed .
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip it for one push:   git push --no-verify
if ! command -v dart >/dev/null 2>&1; then
  echo "pre-push: 'dart' not found in PATH, format check skipped." >&2
  exit 0
fi

zero=0000000000000000000000000000000000000000
list=$(mktemp)
trap 'rm -f "$list"' EXIT
status=0

while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then # new branch: compare with its base
    base=$(git merge-base "$local_sha" origin/develop 2>/dev/null || git merge-base "$local_sha" origin/main 2>/dev/null)
    [ -n "$base" ] || continue
  else
    base=$remote_sha
  fi
  # Files that still exist (deleted ones can't be formatted), generated code excluded.
  git diff -z --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.dart' ':!*.g.dart' ':!*.freezed.dart' >"$list" 2>/dev/null || continue
  [ -s "$list" ] || continue
  xargs -0 dart format --output=none --set-exit-if-changed <"$list" || status=1
done

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "pre-push: the files above are not formatted. Run 'dart format <file>', commit, push again." >&2
fi
exit $status
